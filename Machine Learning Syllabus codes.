        "from sklearn.model_selection import train_test_split\n",
        "rng = np.random.default_rng(42)\n",
        "n = 180\n",
        "X = pd.DataFrame({\n",
        "\"temperature_c\": rng.uniform(18, 33, n),\n",
        "\"deliveries\": rng.integers(2, 12, n),\n",
        "\"promotion\": rng.integers(0, 2, n),\n",
        "})\n",
        "y = (85 + 5.2 * X[\"temperature_c\"] + 3.5 * X[\"deliveries\"]\n",
        "+ 24 * X[\"promotion\"] + rng.normal(0, 12, n))\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "X, y, test_size=0.20, random_state=42\n",
        ")\n",
        "for name, model in [(\"Mean baseline\", DummyRegressor()),\n",
        "(\"Linear regression\", LinearRegression())]:\n",
        "    model.fit(X_train, y_train)\n",
        "    y_hat = model.predict(X_test)\n",
        "    print(name, {\n",
        "    \"MAE\": mean_absolute_error(y_test, y_hat),\n",
        "    \"RMSE\": mean_squared_error(y_test, y_hat) ** 0.5,\n",
        "    \"R2\": r2_score(y_test, y_hat),\n",
        "    })\n",
        "model = LinearRegression().fit(X_train, y_train)\n",
        "y_hat = model.predict(X_test)\n",
        "residual = y_test - y_hat\n",
        "fig, axes = plt.subplots(1, 2, figsize=(9, 3.6))\n",
        "axes[0].scatter(y_test, y_hat, alpha=0.7)\n",
