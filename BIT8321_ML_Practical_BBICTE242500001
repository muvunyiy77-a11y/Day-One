        "from sklearn.ensemble import (\n",
        "    BaggingClassifier,\n",
        "    GradientBoostingClassifier,\n",
        "    RandomForestClassifier,\n",
        "    StackingClassifier,\n",
        ")\n",
        "\n",
        "ensemble_results = []\n",
        "fitted_ensembles = {}\n",
        "\n",
        "base_tree = DecisionTreeClassifier(max_depth=6, min_samples_leaf=8, random_state=RANDOM_STATE)\n",
        "\n",
        "ensemble_estimators = {\n",
        "    \"Bagging\": BaggingClassifier(\n",
        "        estimator=base_tree,\n",
        "        n_estimators=80,\n",
        "        random_state=RANDOM_STATE,\n",
        "        n_jobs=-1,\n",
        "    ),\n",
        "    \"Random Forest\": RandomForestClassifier(\n",
        "        n_estimators=160,\n",
        "        max_depth=8,\n",
        "        min_samples_leaf=4,\n",
        "        class_weight=\"balanced\",\n",
        "        random_state=RANDOM_STATE,\n",
        "        n_jobs=-1,\n",
        "    ),\n",
        "    \"Gradient Boosting\": GradientBoostingClassifier(\n",
        "        n_estimators=90,\n",
        "        learning_rate=0.06,\n",
        "        max_depth=2,\n",
        "        random_state=RANDOM_STATE,\n",
        "    ),\n",
        "}\n",
        "\n",
        "# TODO 5A: fit and evaluate the three ensembles above.\n",
        "for name, estimator in ensemble_estimators.items():\n",
        "    pipeline = Pipeline([\n",
        "        (\"preprocessor\", preprocessor),\n",
        "        (\"model\", estimator),\n",
        "    ])\n",
        "    pipeline.fit(X_train, y_cls_train)\n",
        "    fitted_ensembles[name] = pipeline\n",
        "    ensemble_results.append(evaluate_classifier(name, pipeline, X_val, y_cls_val))\n",
        "\n",
        "stack_base = [\n",
        "    (\"logistic\", LogisticRegression(max_iter=1500, random_state=RANDOM_STATE)),\n",
        "    (\"tree\", DecisionTreeClassifier(max_depth=5, min_samples_leaf=8, random_state=RANDOM_STATE)),\n",
        "    (\"svm\", SVC(kernel=\"rbf\", probability=True, class_weight=\"balanced\", random_state=RANDOM_STATE)),\n",
        "]\n",
        "stack = StackingClassifier(\n",
        "    estimators=stack_base,\n",
        "    final_estimator=LogisticRegression(max_iter=1000, random_state=RANDOM_STATE),\n",
        "    cv=5,\n",
        "    stack_method=\"predict_proba\",\n",
        "    n_jobs=-1,\n",
        ")\n",
